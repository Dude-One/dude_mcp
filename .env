# Open MCP — local environment (copy to .env)

# Auth database (open_mcp_db)
AUTH_DB_PORT=5433
AUTH_DB_PASSWORD=open_mcp_dev
AUTH_DB_NAME=open_mcp_db
AUTH_DB_USER=open_mcp
AUTH_DB_HOST=localhost

# Used by the Go server
DATABASE_URL=postgres://open_mcp:open_mcp_dev@localhost:5433/open_mcp_db?sslmode=disable

# HTTP server port (panel)
PORT=8080

# MCP server port (JSON-RPC)
MCP_PORT=8081

# MCP admin port (health + reload — internal only, proxied by panel)
MCP_ADMIN_PORT=8082

# Swagger cache TTL in seconds (how long MCP caches each domain's swagger spec)
SWAGGER_CACHE_TTL=300

# No shared credentials here — each user provides their own username+password
# in their IDE MCP config (e.g. .cursor/mcp.json headers).
