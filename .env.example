# Open MCP — environment config
# Copy this file to .env and fill in your values.
# For Docker deployments set these as container environment variables directly.

# ── Database ────────────────────────────────────────────────────────────────
# Used by docker-compose to create the Postgres container
AUTH_DB_PORT=5433
AUTH_DB_PASSWORD=change-me-in-dev

# Full DSN used by the Go services (both server + mcp containers)
# In Docker the host is the service name (open-mcp-db), not localhost
DATABASE_URL=postgres://open_mcp:change-me-in-dev@localhost:5433/open_mcp_db?sslmode=disable

# ── Panel server (open-mcp-server) ──────────────────────────────────────────
PORT=8080

# Internal URL the panel uses to reach the MCP container's admin port
# In Docker: use the service name. Locally: use localhost
MCP_ADMIN_URL=http://open-mcp-mcp:8082

# ── MCP server (open-mcp-mcp) ───────────────────────────────────────────────
MCP_PORT=8081
MCP_ADMIN_PORT=8082

# How long (seconds) the MCP server caches fetched Swagger specs
SWAGGER_CACHE_TTL=300

# Path to sources.yaml — used only for first-run seed (DB is source of truth after that)
# Leave as default unless you move the config folder
SOURCES_PATH=./config/sources.yaml

# ── Runtime ─────────────────────────────────────────────────────────────────
# Set to "release" on any deployed environment (disables Gin debug logging)
GIN_MODE=release
